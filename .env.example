# Anthropic API key used for story selection and script writing.
ANTHROPIC_API_KEY=

# Host port for the web panel, RSS feed, and episode MP3s.
CRUFTCAST_PORT=8091

# Initial values for two settings. After the first start they live in the
# database and are edited in the web panel; changing them here does nothing.
CRUFTCAST_OPML_URL=http://your-nas:8082/opml/export
CRUFTCAST_PUBLIC_URL=http://your-nas:8091

# Password for publishing to a web server over SFTP (Settings > Hosting).
# Only needed when web hosting is on.
CRUFTCAST_SFTP_PASSWORD=

# Owner of files written to ./data on the host. Use the output of `id -u`
# and `id -g` on the NAS so the files stay editable over SMB.
CRUFTCAST_UID=1000
CRUFTCAST_GID=1000
